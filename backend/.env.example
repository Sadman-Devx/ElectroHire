# Copy this file to .env (same folder) and fill in real values.
# .env is already in .gitignore -- it will never be committed.
#
#   cp .env.example .env
#
# For LOCAL DEVELOPMENT, the values below already work as-is (just
# copy the file). For PRODUCTION, set DEBUG=False and replace
# SECRET_KEY / ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS with real values
# -- see settings.py's own comments for exactly what each one gates.

# ── Core ──────────────────────────────────────────────────────────
# True for local development only. Leaving this True in production
# exposes full stack traces, source code, settings, and SQL queries
# in every error page -- see settings.py's own comment on DEBUG.
DEBUG=True

# Django refuses to start with DEBUG=False and no SECRET_KEY set (see
# settings.py) -- generate a real one for production with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The value below is fine for local dev only; never reuse it anywhere real.
SECRET_KEY=local-dev-secret-key-not-for-production-use-only

# Comma-separated list of domains this backend is allowed to serve.
# Required (non-empty) once DEBUG=False. Example:
#   ALLOWED_HOSTS=api.electrohire.com,electrohire.com
ALLOWED_HOSTS=

# Comma-separated list of frontend origins allowed to call this API.
# Leave empty for local dev (falls back to the two local Vite/CRA
# ports automatically -- see settings.py). Example for production:
#   CORS_ALLOWED_ORIGINS=https://electrohire.com,https://www.electrohire.com
CORS_ALLOWED_ORIGINS=

# ── Optional: Redis (shared channel layer + shared throttle cache) ──
# Leave unset for local dev / a single-process deployment (falls back
# to Django's built-in in-memory backends for both). Required once you
# run more than one worker process/machine, so real-time chat delivery
# and rate-limit counters are shared across all of them instead of each
# worker enforcing its own separate, smaller limit. Most hosts (Railway,
# Render, Heroku + a Redis add-on, etc.) inject this automatically once
# you attach a Redis instance.
# REDIS_URL=redis://localhost:6379/0